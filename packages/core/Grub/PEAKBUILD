pkgname="grub-k2"
pkgver="2.12"
pkgrel=1
pkgdesc="GNU GRand Unified Bootloader for K2-Linux"
url="https://ftp.gnu.org/gnu/grub/grub-${pkgver}.tar.xz"

build() {
    curl -sSL "$url" -o "grub-${pkgver}.tar.xz"
    tar -xf "grub-${pkgver}.tar.xz"
    cd "grub-${pkgver}"

    ./configure \
        --prefix=/usr \
        --sbindir=/sbin \
        --sysconfdir=/etc \
        --disable-werror

    make -j$(nproc)
}

package() {
    local destdir="$1"
    cd "grub-${pkgver}"

    make DESTDIR="$destdir" install

    mkdir -p "${destdir}/etc/default"
    cat <<EOF > "${destdir}/etc/default/grub"
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="K2-Linux"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
EOF
}